{
  "name": "@nightcode/server",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "postinstall": "bun run --cwd ../database db:generate"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.16",
    "@ai-sdk/openai": "^4.0.16",
    "@ai-sdk/provider-utils": "^5.0.11",
    "@clerk/backend": "^3.13.1",
    "@hono/zod-validator": "^0.8.0",
    "@nightcode/database": "workspace:*",
    "@nightcode/shared": "workspace:*",
    "@sentry/bun": "^10.65.0",
    "@sentry/hono": "^10.65.0",
    "ai": "^7.0.22",
    "dotenv": "^17.4.2",
    "hono": "^4.12.28",
    "zod": "^4.4.3"
  }
}